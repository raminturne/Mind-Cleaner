{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mind Cleaner",
  "version": "0.4.7",
  "identifier": "com.mindcleaner.desktop",
  "build": {
    "frontendDist": "../studio"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mind Cleaner",
        "width": 1340,
        "height": 840,
        "minWidth": 780,
        "minHeight": 520,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A calm canvas for connected thoughts",
    "longDescription": "Mind Cleaner Studio is a local-first desktop mind-mapping app with flexible branch styles, spring motion, rich attachments, an English interface with multilingual map text, AI draft previews, and PNG/Markdown/JSON export.",
    "icon": [
      "icons-studio/32x32.png",
      "icons-studio/128x128.png",
      "icons-studio/128x128@2x.png",
      "icons-studio/icon.icns",
      "icons-studio/icon.ico"
    ]
  }
}
